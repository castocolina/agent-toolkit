{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "YourCompany Design Tokens 1.0.0. DTCG 2025.10. $type sits on every token so the schema checks values. color.semantic, font.role and spacing roles are what components consume; color.semantic holds the light theme, dark is a second file with the same paths.",
  "color": {
    "primitive": {
      "white": {
        "$type": "color",
        "$value": {"colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#ffffff"}
      },
      "gray": {
        "50": {
          "$type": "color",
          "$value": {"colorSpace": "srgb", "components": [0.9765, 0.9804, 0.9843], "hex": "#f9fafb"}
        },
        "100": {
          "$type": "color",
          "$value": {"colorSpace": "srgb", "components": [0.9529, 0.9569, 0.9647], "hex": "#f3f4f6"}
        },
        "500": {
          "$type": "color",
          "$value": {"colorSpace": "srgb", "components": [0.4196, 0.4471, 0.502], "hex": "#6b7280"}
        },
        "600": {
          "$type": "color",
          "$value": {"colorSpace": "srgb", "components": [0.2941, 0.3333, 0.3882], "hex": "#4b5563"}
        },
        "900": {
          "$type": "color",
          "$value": {"colorSpace": "srgb", "components": [0.0667, 0.0941, 0.1529], "hex": "#111827"}
        }
      },
      "blue": {
        "600": {
          "$type": "color",
          "$value": {"colorSpace": "srgb", "components": [0.1451, 0.3882, 0.9216], "hex": "#2563eb"}
        },
        "700": {
          "$type": "color",
          "$value": {"colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8"}
        }
      },
      "red": {
        "600": {
          "$type": "color",
          "$value": {"colorSpace": "srgb", "components": [0.8627, 0.149, 0.149], "hex": "#dc2626"}
        }
      },
      "green": {
        "700": {
          "$type": "color",
          "$value": {"colorSpace": "srgb", "components": [0.0824, 0.502, 0.2392], "hex": "#15803d"}
        }
      }
    },
    "semantic": {
      "text": {
        "primary": {"$type": "color", "$value": "{color.primitive.gray.900}"},
        "secondary": {"$type": "color", "$value": "{color.primitive.gray.600}"},
        "onAction": {"$type": "color", "$value": "{color.primitive.white}"}
      },
      "surface": {
        "default": {"$type": "color", "$value": "{color.primitive.white}"},
        "raised": {"$type": "color", "$value": "{color.primitive.gray.50}"},
        "sunken": {"$type": "color", "$value": "{color.primitive.gray.100}"}
      },
      "border": {"default": {"$type": "color", "$value": "{color.primitive.gray.500}"}},
      "action": {
        "default": {"$type": "color", "$value": "{color.primitive.blue.600}"},
        "hover": {"$type": "color", "$value": "{color.primitive.blue.700}"}
      },
      "focus": {"ring": {"$type": "color", "$value": "{color.primitive.blue.600}"}},
      "feedback": {
        "error": {"$type": "color", "$value": "{color.primitive.red.600}"},
        "success": {"$type": "color", "$value": "{color.primitive.green.700}"}
      }
    }
  },
  "font": {
    "family": {"sans": {"$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"]}},
    "weight": {
      "regular": {"$type": "fontWeight", "$value": 400},
      "medium": {"$type": "fontWeight", "$value": 500}
    },
    "size": {
      "sm": {"$type": "dimension", "$value": {"value": 0.875, "unit": "rem"}},
      "md": {"$type": "dimension", "$value": {"value": 1, "unit": "rem"}},
      "lg": {"$type": "dimension", "$value": {"value": 1.25, "unit": "rem"}}
    },
    "lineHeight": {"tight": {"$type": "number", "$value": 1.25}, "normal": {"$type": "number", "$value": 1.5}},
    "role": {
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.md}",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": {"value": 0, "unit": "px"},
          "lineHeight": "{font.lineHeight.normal}"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "{font.size.sm}",
          "fontWeight": "{font.weight.medium}",
          "letterSpacing": {"value": 0, "unit": "px"},
          "lineHeight": "{font.lineHeight.tight}"
        }
      }
    }
  },
  "spacing": {
    "scale": {
      "1": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}},
      "2": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}},
      "3": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}},
      "4": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}},
      "6": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}}
    },
    "control": {
      "inlinePadding": {"$type": "dimension", "$value": "{spacing.scale.3}"},
      "blockPadding": {"$type": "dimension", "$value": "{spacing.scale.2}"}
    },
    "stack": {"gap": {"$type": "dimension", "$value": "{spacing.scale.4}"}}
  },
  "radius": {"control": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}}},
  "duration": {"fast": {"$type": "duration", "$value": {"value": 150, "unit": "ms"}}}
}
