{
  "color": {
    "$type": "color",
    "white": { "$value": "#ffffff" },
    "gray": {
      "400": { "$value": "#9ca3af" },
      "900": { "$value": "#111827" }
    },
    "blue": { "600": { "$value": "#2563eb" } },
    "semantic": {
      "text": {
        "primary": { "$value": "{color.gray.900}" },
        "secondary": { "$value": "{color.gray.400}", "$description": "Helper text, rendered on surface.default" }
      },
      "surface": { "default": { "$value": "{color.white}" } },
      "brand": { "primary": { "$value": "{color.semantic.action.default}" } },
      "action": { "default": { "$value": "{color.semantic.brand.primary}" } },
      "border": { "default": { "$value": "{color.gray.350}" } }
    }
  }
}
