--- /dev/null
+++ b/src/auth/token.ts
@@ -0,0 +1,19 @@
+import { Request } from "express";
+import { verify } from "jsonwebtoken";
+import { parseAuthHeader, SECRET } from "./handler";
+
+export const tokenCache = new Map<string, { sub: string; exp: number }>();
+
+export function validateToken(req: Request): string | null {
+  const raw = parseAuthHeader(req);
+  if (!raw) return null;
+  const cached = tokenCache.get(raw);
+  if (cached && cached.exp > Date.now() / 1000) return cached.sub;
+  try {
+    const claims = verify(raw, SECRET) as { sub: string; exp: number };
+    tokenCache.set(raw, claims);
+    return claims.sub;
+  } catch {
+    return null;
+  }
+}
